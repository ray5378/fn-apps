#!/bin/sh
APPDEST="${TRIM_APPDEST:-/var/apps/fn-trim.vm/target}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/fn-trim.vm/var}"
PID_FILE="${PKGVAR}/server.pid"
LOG_FILE="${PKGVAR}/server.log"
PORT=5800
SERVER="${APPDEST}/server/server.py"
WWW="${APPDEST}/www"

start() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    return 0
  fi
  mkdir -p "$PKGVAR"
  nohup python3 "$SERVER" --port "$PORT" --www "$WWW" --log "$LOG_FILE" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 1
  if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    return 0
  fi
  return 1
}

stop() {
  if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null
    sleep 1
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    rm -f "$PID_FILE"
  fi
  return 0
}

status() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    exit 0
  fi
  exit 3
}

case $1 in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) exit 1 ;;
esac
