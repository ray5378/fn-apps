#!/bin/sh
APPDEST="${TRIM_APPDEST:-/var/apps/fn-trim.vm/target}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/fn-trim.vm/var}"
PID_FILE="${PKGVAR}/server.pid"
LOG_FILE="${PKGVAR}/server.log"
PORT=5800
SERVER="${APPDEST}/server/server.py"
WWW="${APPDEST}/www"

start() {
  stop
  mkdir -p "$PKGVAR"
  PYTHON=$(command -v python3) || PYTHON=""
  if [ -z "$PYTHON" ]; then
    echo "python3 not found" >> "$LOG_FILE"
    return 1
  fi
  nohup "$PYTHON" "$SERVER" --port "$PORT" --www "$WWW" --log "$LOG_FILE" >> "$LOG_FILE" 2>&1 &
  pid=$!
  echo "$pid" > "$PID_FILE"
  sleep 2
  if kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  return 1
}

stop() {
  if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null
    sleep 1
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    rm -f "$PID_FILE"
  fi
  fuser -k "${PORT}/tcp" 2>/dev/null || true
  return 0
}

status() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    exit 0
  fi
  exit 3
}

case $1 in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) exit 1 ;;
esac
